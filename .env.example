# Copy this file to .env and fill in your keys. .env is gitignored.
# Free Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional fallback when Gemini's free quota runs out: https://console.groq.com/keys
GROQ_API_KEY=
# For linkedin_post_mailer.py (emails your resume to hiring posts).
# Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it here.
SMTP_USER=
SMTP_APP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
